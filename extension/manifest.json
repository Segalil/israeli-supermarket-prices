{
  "manifest_version": 3,
  "name": "ליםSlim — העברת סל לרשתות",
  "version": "0.5.0",
  "description": "מעביר את רשימת הקניות מ־ליםSlim אל עגלת הקנייה באתר הרשת — בתוך החשבון שלכם ובשליטתכם המלאה.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://slim-super.com/",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://slim-super.com/*",
        "https://www.slim-super.com/*",
        "https://segalil.github.io/*",
        "http://localhost:8737/*",
        "http://localhost:8123/*"
      ],
      "js": [
        "bridge.js"
      ]
    },
    {
      "matches": [
        "https://www.shufersal.co.il/*"
      ],
      "js": [
        "chains/shufersal.js",
        "panel.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://www.rami-levy.co.il/*"
      ],
      "js": [
        "chains/rami-levy.js",
        "panel.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://yochananof.co.il/*"
      ],
      "js": [
        "chains/yochananof.js",
        "panel.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://www.victoryonline.co.il/*"
      ],
      "js": [
        "chains/victory.js",
        "panel.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://www.carrefour.co.il/*"
      ],
      "js": [
        "chains/carrefour.js",
        "panel.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://shop.hazi-hinam.co.il/*"
      ],
      "js": [
        "chains/hazi-hinam.js",
        "panel.js"
      ],
      "css": [
        "panel.css"
      ]
    }
  ]
}